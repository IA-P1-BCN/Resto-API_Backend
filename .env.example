# Copia este fichero como .env y rellena los valores. NUNCA subas el .env al repo.

# --- Entorno ---
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# --- Base de datos ---
# Local (Postgres de Docker):
DATABASE_URL=postgresql+psycopg://restoapi:restoapi@localhost:5432/restoapi
# Si el 5432 está ocupado por otro Postgres, pon DB_PORT=5433 y usa ese puerto aquí:
# DB_PORT=5433
# Neon (rama dev), formato:
# DATABASE_URL=postgresql+psycopg://USER:PASS@HOST-pooler.REGION.aws.neon.tech/restoapi?sslmode=require

# --- Auth (JWT) ---
# Genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=cambia-esta-clave
JWT_EXPIRE_MINUTES=60

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Email (Brevo) ---
EMAIL_ENABLED=false
BREVO_API_KEY=
MAIL_FROM=

# --- Crear la contraseña por email (HU-52) ---
# URL del frontend para el enlace del email, sin / final, y horas de validez del enlace.
FRONTEND_URL=http://localhost:5173
PASSWORD_TOKEN_EXPIRE_HOURS=48

# --- Verificación de email y recuperación de contraseña (HU-33) ---
# Horas de validez del enlace de verificación y del de "he olvidado mi contraseña", y
# segundos mínimos entre dos envíos del mismo tipo a una cuenta (sin 429).
EMAIL_VERIFY_EXPIRE_HOURS=48
PASSWORD_RESET_EXPIRE_HOURS=1
TOKEN_RESEND_COOLDOWN_SECONDS=60

# --- Login social (HU-38) ---
# Apps OAuth de Google y GitHub; vacías = el proveedor responde 503. Secretos solo en Render/.env local.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Límite de intentos de login (HU-31) ---
# Tras LOGIN_MAX_ATTEMPTS fallos desde la misma IP para el mismo email, POST /auth/login responde
# 429 hasta que pasan LOGIN_WINDOW_MINUTES desde el primer fallo. Los contadores viven en memoria.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# Cabecera con la IP real del cliente. Vacía en local (se usa la IP de la conexión).
# En Render: True-Client-IP. Nunca X-Forwarded-For, porque la puede escribir el cliente.
CLIENT_IP_HEADER=

# --- Verificación en dos pasos (HU-37) ---
# Clave Fernet para cifrar los secretos TOTP. Vacía = se deriva de JWT_SECRET_KEY.
# Si se cambia (o cambia JWT_SECRET_KEY sin ella), la 2FA ya activada deja de funcionar.
# Genera una con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# --- Estadísticas (HU-15) ---
# Segundos que se guardan en caché las respuestas de /stats (0 = sin caché).
STATS_CACHE_TTL=60

# --- Reservas (HU-51) ---
# Zona horaria del restaurante. reserved_at se guarda como hora local sin zona y se
# compara con la hora actual en esta zona para rechazar reservas en el pasado.
RESTAURANT_TIMEZONE=Europe/Madrid
